# Phase 1: Layer CTF-analysis utilities on the EXISTING restricted solver image.
# Build the existing image first: docker build -f Dockerfile.solver -t ctf-solver:dev .
ARG BASE_IMAGE=ctf-solver:dev
FROM ${BASE_IMAGE}

USER root
ENV DEBIAN_FRONTEND=noninteractive

# Cross-category CTF toolkit. tshark is preseeded non-interactive so the build
# does not hang on its setuid prompt.
RUN echo "wireshark-common wireshark-common/install-setuid boolean false" \
        | debconf-set-selections
# Core utilities MUST be present. The extra tools are installed resiliently
# (one per apt call) so a single unavailable package can never fail the whole
# image build -- the build logs a WARN and moves on.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        checksec \
        file \
        gdb \
        gcc \
        make \
        curl \
        git \
        python3-venv \
        libimage-exiftool-perl \
        unzip \
        p7zip-full \
        xxd \
        socat \
        xz-utils zstd lz4 cabextract p7zip-full \
        llvm \
        zbar-tools libzbar0 poppler-utils qpdf imagemagick sqlite3 \
    && for pkg in ltrace strace patchelf binwalk foremost steghide tshark ruby ruby-dev \
                  john hashcat pocl-opencl-icd ocl-icd-libopencl1 wordlists; do \
         apt-get install -y --no-install-recommends "$pkg" \
           || echo "WARN: apt package $pkg unavailable; skipping"; \
       done \
    && rm -rf /var/lib/apt/lists/*

# Decompress the rockyou wordlist (the `wordlists` package ships it gzipped) so
# crackers can point straight at /usr/share/wordlists/rockyou.txt. Soft-fail so
# a missing wordlist never breaks the image.
RUN gunzip -kf /usr/share/wordlists/rockyou.txt.gz 2>/dev/null \
    && ls -la /usr/share/wordlists/rockyou.txt \
    || echo "WARN: rockyou wordlist unavailable"

# radare2 is NOT packaged for Debian bookworm, so build it from source.
# Soft-fail: objdump/gdb + the disassemble_binary tool cover the essentials.
RUN git clone --depth 1 https://github.com/radareorg/radare2 /tmp/radare2 \
        && /tmp/radare2/sys/install.sh \
        && rm -rf /tmp/radare2 \
    || echo "WARN: radare2 source build failed; use objdump/gdb instead"

# Ruby-based CTF tools: one_gadget (pwn one-shot gadgets) and zsteg (PNG/BMP
# steganography). Separate layer so a gem failure is easy to isolate.
RUN gem install --no-document one_gadget zsteg || \
    echo "WARN: ruby gem install failed; one_gadget/zsteg unavailable"

# Keep solver-side third-party packages separate from the controller's venv.
COPY requirements.solver-tools.txt /opt/ctf-tools/requirements.solver-tools.txt
RUN python3 -m venv /opt/ctf-tools-venv \
    && /opt/ctf-tools-venv/bin/python -m pip install --no-cache-dir \
       -r /opt/ctf-tools/requirements.solver-tools.txt \
    && chmod -R a+rX /opt/ctf-tools-venv

# impacket: Kerberos / AD tooling (GetNPUsers, krb5 crypto helpers) for
# forensics and AD challenges. Soft-fail so the rest of the image still builds.
RUN /opt/ctf-tools-venv/bin/python -m pip install --no-cache-dir impacket \
        && chmod -R a+rX /opt/ctf-tools-venv \
    || echo "WARN: impacket install failed; Kerberos helpers unavailable"

# PyTorch (CPU-only) for ML-themed challenges that ship serialized .pt models.
# The solver runs with --network none, so nothing can be pip-installed at
# attempt time; it must be baked in here. The CPU wheel avoids the large CUDA
# payload. numpy comes from the requirements file above (also a torch dep).
RUN /opt/ctf-tools-venv/bin/python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu torch \
    && chmod -R a+rX /opt/ctf-tools-venv

# angr: symbolic execution for hard reversing/crypto. Heavy (~hundreds of MB).
# Isolated layer with a soft failure so the rest of the image still builds if
# angr's wheels are unavailable for this platform. Drop this RUN to slim the
# image if you don't need symbolic execution.
RUN /opt/ctf-tools-venv/bin/python -m pip install --no-cache-dir angr \
        && chmod -R a+rX /opt/ctf-tools-venv \
    || echo "WARN: angr install failed; symbolic execution unavailable"

# --- Crack-stack fix layer (appended so the heavy torch/angr layers stay cached) ---
# 1) Debian installs `john` under /usr/sbin, off the non-root PATH -- symlink it
#    onto PATH (reinstalling only if it is genuinely absent).
# 2) Debian's `wordlists` package does NOT ship rockyou, so fetch it directly.
RUN ( [ -x /usr/sbin/john ] || command -v john >/dev/null 2>&1 ) \
      || ( apt-get update \
           && apt-get install -y --no-install-recommends john ; \
           rm -rf /var/lib/apt/lists/* ) ; \
    ( [ -x /usr/sbin/john ] && ln -sf /usr/sbin/john /usr/local/bin/john ) || true ; \
    mkdir -p /usr/share/wordlists ; \
    curl -fsSL -o /usr/share/wordlists/rockyou.txt \
      https://github.com/brannondorsey/naive-hashcat/releases/download/data/rockyou.txt \
      || echo "WARN: rockyou download failed" ; \
    echo "=== CRACK STACK STATUS ===" ; \
    ( command -v john || ls -la /usr/sbin/john || echo "john MISSING" ) ; \
    ( command -v hashcat || echo "hashcat MISSING" ) ; \
    ( ls -la /usr/share/wordlists/rockyou.txt || echo "rockyou MISSING" )

ENV PATH="/opt/ctf-tools-venv/bin:/usr/sbin:${PATH}"
COPY ctf_tool_audit.py /opt/ctf-tools/ctf_tool_audit.py
COPY test_ctf_tooling.py /opt/ctf-tools/test_ctf_tooling.py
RUN chmod 0644 /opt/ctf-tools/*.py /opt/ctf-tools/*.txt

# Match the existing course sandbox's non-root UID/GID; never leave the
# solver running as root after installing packages.
USER 10001:10001
